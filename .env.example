# ==============================================================================
# AI GitHub Portfolio Generator - Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL - Neon / Supabase / Local)
# ------------------------------------------------------------------------------
# PostgreSQL connection string. For Neon or Supabase serverless, append '?sslmode=require'.
# Example: postgresql://username:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_portfolio_db?sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. Authentication (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
# Canonical URL of your application (localhost in dev, your Vercel domain in prod)
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt session tokens and JWTs.
# Generate one in terminal: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-string"

# ------------------------------------------------------------------------------
# 3. GitHub OAuth Application
# ------------------------------------------------------------------------------
# Create an OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="gh_oauth_client_id_placeholder"
GITHUB_CLIENT_SECRET="gh_oauth_client_secret_placeholder"

# ------------------------------------------------------------------------------
# 4. Google Gemini API
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_placeholder"

# ------------------------------------------------------------------------------
# 5. Public Application URL
# ------------------------------------------------------------------------------
# Publicly accessible origin for generating absolute URLs, OpenGraph tags, and social cards
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
